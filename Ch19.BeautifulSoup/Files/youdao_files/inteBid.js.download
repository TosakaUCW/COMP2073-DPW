$(function () {

	$.ajax({
		type:"post",
		url:"/portal/inteBid/getInteBidList.do",
		data:{},
		dataType:"html",
		contentType:"application/x-www-form-urlencoded; charset=UTF-8",
		success:function(temp){
			$("#showIntebidDatalist").remove();
			$("#inteBidViewDiv").after(temp);
		}
	});
	
});

